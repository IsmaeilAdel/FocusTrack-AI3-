<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FocusTrack AI — نظام تتبع التركيز الذكي</title>
    <!-- Tailwind CSS للستايل السريع -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Mediapipe Face Mesh للتعرف الحقيقي على الوجه واتجاه العين والرأس -->
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/face_mesh.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col">

    <!-- الهيدر -->
    <header class="bg-slate-800 border-b border-slate-700 p-4 flex justify-between items-center shadow-md">
        <div class="flex items-center gap-3">
            <span class="text-indigo-400 text-2xl">◎</span>
            <div>
                <h1 class="text-xl font-bold">FocusTrack AI</h1>
                <p class="text-xs text-slate-400">ركز أكتر... اتعلم أفضل (بكاميرا حقيقية)</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button id="toggleCamBtn" onclick="toggleCamera()" class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg text-sm font-semibold transition cursor-pointer">
                تشغيل الكاميرا
            </button>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="flex-1 p-4 md:p-6 max-w-6xl mx-auto w-full grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- القسم الأيمن: معاينة الكاميرا والتحليل -->
        <div class="md:col-span-2 flex flex-col gap-6">
            
            <!-- كاميرا حقيقية -->
            <div class="bg-slate-800 rounded-2xl p-4 border border-slate-700 shadow-xl relative overflow-hidden flex flex-col items-center">
                <div class="flex justify-between w-full mb-3 items-center">
                    <h2 class="font-bold text-lg">معاينة الكاميرا المباشرة</h2>
                    <span id="statusBadge" class="bg-amber-500/20 text-amber-400 text-xs px-3 py-1 rounded-full font-medium flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span> في انتظار تشغيل الكاميرا
                    </span>
                </div>

                <div class="relative w-full aspect-video bg-black rounded-xl overflow-hidden flex items-center justify-center border border-slate-700">
                    <!-- عنصر الفيديو الحقيقي -->
                    <video id="webcam" class="absolute inset-0 w-full h-full object-cover -scale-x-100" playsinline></video>
                    <!-- عنصر الكانفاس لرسم الشبكة الوجهية -->
                    <canvas id="output_canvas" class="absolute inset-0 w-full h-full object-cover -scale-x-100 pointer-events-none"></canvas>
                    
                    <!-- تنبيه انخفاض التركيز -->
                    <div id="alertBox" class="hidden absolute top-4 inset-x-4 bg-red-600/90 text-white p-3 rounded-xl shadow-lg backdrop-blur-md flex items-center justify-between animate-bounce">
                        <div class="flex items-center gap-2">
                            <span>⚠️</span>
                            <span class="text-sm font-bold">مستوى التركيز منخفض! حاول العودة للشاشة.</span>
                        </div>
                    </div>
                </div>
                <p class="text-xs text-slate-400 mt-3 text-center">يتم تحليل الوجه محلياً في متصفحك للحفاظ على الخصوصية التامة.</p>
            </div>

        </div>

        <!-- القسم الأيسر: لوحة المؤشرات والإحصائيات -->
        <div class="flex flex-col gap-6">
            
            <!-- مؤشر التركيز الحالي -->
            <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-xl flex flex-col items-center justify-center text-center">
                <h3 class="text-slate-400 text-sm mb-3">مستوى التركيز الحالي</h3>
                <div class="relative flex items-center justify-center mb-2">
                    <span id="focusScoreText" class="text-4xl font-extrabold text-indigo-400">--%</span>
                </div>
                <p id="focusStatusLabel" class="text-xs text-slate-400">اضغط "تشغيل الكاميرا" لبدء القياس</p>
            </div>

            <!-- تفاصيل التحليل الذكي -->
            <div class="bg-slate-800 rounded-2xl p-5 border border-slate-700 shadow-xl flex flex-col gap-4">
                <h3 class="font-bold text-base border-b border-slate-700 pb-2">تحليلات الذكاء الاصطناعي</h3>
                
                <div class="flex flex-col gap-3 text-sm">
                    <div class="flex justify-between items-center">
                        <span class="text-slate-300">👁 حالة العين (التركيز للأمام)</span>
                        <span id="eyeStatus" class="font-bold text-slate-500">غير متصل</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-300">🧑 وضعية الرأس</span>
                        <span id="headStatus" class="font-bold text-slate-500">غير متصل</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-slate-300">👤 اكتشاف الوجه</span>
                        <span id="faceDetected" class="font-bold text-slate-500">لا يوجد وجه</span>
                    </div>
                </div>
            </div>

        </div>

    </main>

    <!-- الفوتر -->
    <footer class="bg-slate-800 border-t border-slate-700 py-4 text-center text-xs text-slate-400">
        <p>مشروع FocusTrack AI — نظام تجريبي متطور لمتابعة التركيز التعليمي.</p>
    </footer>

    <!-- سكود البرمجة والربط بـ Mediapipe -->
    <script>
        const videoElement = document.getElementById('webcam');
        const canvasElement = document.getElementById('output_canvas');
        const canvasCtx = canvasElement.getContext('2d');
        
        let cameraActive = false;
        let camera = null;
        let faceMesh = null;

        const focusScoreText = document.getElementById('focusScoreText');
        const focusStatusLabel = document.getElementById('focusStatusLabel');
        const statusBadge = document.getElementById('statusBadge');
        const alertBox = document.getElementById('alertBox');
        const eyeStatus = document.getElementById('eyeStatus');
        const headStatus = document.getElementById('headStatus');
        const faceDetected = document.getElementById('faceDetected');
        const toggleCamBtn = document.getElementById('toggleCamBtn');

        // إعداد نموذج Mediapipe Face Mesh
        faceMesh = new FaceMesh({
            locateFile: (file) => `https://cdn.jsdelivr.net/npm/@mediapipe/face_mesh/${file}`
        });

        faceMesh.setOptions({
            maxNumFaces: 1,
            refineLandmarks: true,
            minDetectionConfidence: 0.5,
            minTrackingConfidence: 0.5
        });

        faceMesh.onResults(onResults);

        function onResults(results) {
            canvasElement.width = videoElement.videoWidth || 640;
            canvasElement.height = videoElement.videoHeight || 480;

            canvasCtx.save();
            canvasCtx.clearRect(0, 0, canvasElement.width, canvasElement.height);

            if (results.multiFaceLandmarks && results.multiFaceLandmarks.length > 0) {
                const landmarks = results.multiFaceLandmarks[0];
                
                faceDetected.textContent = "موجود ✅";
                faceDetected.className = "font-bold text-emerald-400";

                // حساب تقديري لاتجاه الرأس والعين بناء على إحداثيات النقاط الرئيسية (Landmarks)
                // الأنف: 1، العين اليمنى: 33، العين اليسرى: 263
                const nose = landmarks[1];
                const leftEye = landmarks[33];
                const rightEye = landmarks[263];

                // حساب زاوية انحراف الرأس البسيطة أفقياً
                const headTilt = Math.abs(leftEye.y - rightEye.y);
                
                let isHeadStraight = headTilt < 0.05;
                let isLookingForward = Math.abs(nose.x - 0.5) < 0.15; // يقترب من منتصف الشاشة أفقيًا

                if (isHeadStraight) {
                    headStatus.textContent = "مستقيم وفاضل 🟢";
                    headStatus.className = "font-bold text-emerald-400";
                } else {
                    headStatus.textContent = "مائل أو منحرف 🟡";
                    headStatus.className = "font-bold text-amber-400";
                }

                if (isLookingForward) {
                    eyeStatus.textContent = "ينظر للشاشة 🟢";
                    eyeStatus.className = "font-bold text-emerald-400";
                } else {
                    eyeStatus.textContent = "مشتت / بعيد 🔴";
                    eyeStatus.className = "font-bold text-red-400";
                }

                // حساب مؤشر التركيز (من 0 إلى 100%)
                let score = 85;
                if (!isHeadStraight) score -= 20;
                if (!isLookingForward) score -= 35;
                score = Math.max(10, Math.min(100, score));

                focusScoreText.textContent = score + "%";
                
                if (score > 70) {
                    focusScoreText.className = "text-4xl font-extrabold text-emerald-400";
                    focusStatusLabel.textContent = "حالة ممتازة: الطالب مركز تماماً";
                    alertBox.classList.add('hidden');
                } else {
                    focusScoreText.className = "text-4xl font-extrabold text-red-400";
                    focusStatusLabel.textContent = "تنبيه: انخفاض ملحوظ في التركيز";
                    alertBox.classList.remove('hidden');
                }

            } else {
                faceDetected.textContent = "لا يوجد وجه ❌";
                faceDetected.className = "font-bold text-red-400";
                eyeStatus.textContent = "غير متاح";
                headStatus.textContent = "غير متاح";
                focusScoreText.textContent = "0%";
                focusStatusLabel.textContent = "الرجاء الجلوس أمام الكاميرا بوضوح";
                alertBox.classList.remove('hidden');
            }

            canvasCtx.restore();
        }

        async function toggleCamera() {
            if (!cameraActive) {
                try {
                    camera = new Camera(videoElement, {
                        onFrame: async () => {
                            await faceMesh.send({ image: videoElement });
                        },
                        width: 640,
                        height: 480
                    });
                    await camera.start();
                    cameraActive = true;
                    toggleCamBtn.textContent = "إيقاف الكاميرا";
                    toggleCamBtn.className = "bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-lg text-sm font-semibold transition cursor-pointer";
                    statusBadge.className = "bg-emerald-500/20 text-emerald-400 text-xs px-3 py-1 rounded-full font-medium flex items-center gap-1.5";
                    statusBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> الكاميرا تعمل`;
                } catch (err) {
                    alert("تعذر تشغيل الكاميرا. تأكد من إعطاء الصلاحيات في المتصفح.");
                    console.error(err);
                }
            } else {
                if (camera) {
                    // إيقاف بث الفيديو والكاميرا
                    const stream = videoElement.srcObject;
                    if (stream) {
                        stream.getTracks().forEach(track => track.stop());
                    }
                    videoElement.srcObject = null;
                }
                cameraActive = false;
                toggleCamBtn.textContent = "تشغيل الكاميرا";
                toggleCamBtn.className = "bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg text-sm font-semibold transition cursor-pointer";
                statusBadge.className = "bg-amber-500/20 text-amber-400 text-xs px-3 py-1 rounded-full font-medium flex items-center gap-1.5";
                statusBadge.innerHTML = `<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span> متوقف`;
                
                focusScoreText.textContent = "--%";
                focusStatusLabel.textContent = "اضغط 'تشغيل الكاميرا' لبدء القياس";
                eyeStatus.textContent = "غير متصل";
                headStatus.textContent = "غير متصل";
                faceDetected.textContent = "لا يوجد وجه";
                alertBox.classList.add('hidden');
            }
        }
    </script>
</body>
</html>
